<dx:ThemedWindow x:Class="NeuralPad.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
    xmlns:dxprg="http://schemas.devexpress.com/winfx/2008/xaml/propertygrid"
    xmlns:local="clr-namespace:NeuralPad.App.Controls"
    Title="NeuralPad" Width="1500" Height="900" WindowStartupLocation="CenterScreen">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="8" Margin="0,0,0,8" BorderBrush="#40444B" BorderThickness="1" CornerRadius="6">
            <StackPanel Orientation="Horizontal">
                <Button Content="▶ Run" Command="{Binding RunCommand}" Padding="14,7" Margin="0,0,6,0"/>
                <Button Content="⏭ Step" Command="{Binding StepCommand}" Padding="14,7" Margin="0,0,6,0"/>
                <Button Content="↻ Reset" Command="{Binding ResetCommand}" Padding="14,7" Margin="0,0,20,0"/>
                <TextBlock Text="X1" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <dxe:SpinEdit Width="90" Value="{Binding X1, UpdateSourceTrigger=PropertyChanged}" Increment="0.05" Mask="n2"/>
                <TextBlock Text="X2" VerticalAlignment="Center" Margin="15,0,5,0"/>
                <dxe:SpinEdit Width="90" Value="{Binding X2, UpdateSourceTrigger=PropertyChanged}" Increment="0.05" Mask="n2"/>
                <TextBlock Text="Output" VerticalAlignment="Center" Margin="25,0,5,0" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding OutputText}" VerticalAlignment="Center" FontSize="18"/>
            </StackPanel>
        </Border>

        <dxdo:DockLayoutManager Grid.Row="1" DockingStyle="VS2010">
            <dxdo:LayoutGroup Orientation="Horizontal">
                <dxdo:LayoutPanel Caption="Forward Trace" ItemWidth="280">
                    <ListBox ItemsSource="{Binding Trace}" SelectedItem="{Binding CurrentStep}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Formula}" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </dxdo:LayoutPanel>

                <dxdo:DocumentGroup>
                    <dxdo:DocumentPanel Caption="Network" AllowClose="False">
                        <local:NetworkCanvas Network="{Binding Network}"
                                             CurrentStep="{Binding CurrentStep}"
                                             SelectedObject="{Binding SelectedObject, Mode=TwoWay}"/>
                    </dxdo:DocumentPanel>
                </dxdo:DocumentGroup>

                <dxdo:LayoutPanel Caption="Inspector" ItemWidth="320">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding SelectionText}" Margin="8" TextWrapping="Wrap" FontWeight="SemiBold"/>
                            <dxprg:PropertyGridControl Grid.Row="1"
                                SelectedObject="{Binding SelectedObject}"
                                ShowSearchBox="True"/>
                        </Grid>
                        <Border Grid.Row="1" Margin="0,8,0,0" Padding="10" BorderBrush="#40444B" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Current math" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding Formula}" TextWrapping="Wrap" FontFamily="Consolas"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </dxdo:LayoutPanel>
            </dxdo:LayoutGroup>
        </dxdo:DockLayoutManager>

        <StatusBar Grid.Row="2" Margin="0,8,0,0">
            <TextBlock Text="{Binding StepStatus}"/>
        </StatusBar>
    </Grid>
</dx:ThemedWindow>