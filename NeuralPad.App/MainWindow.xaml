<dx:ThemedWindow x:Class="NeuralPad.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
    xmlns:dxprg="http://schemas.devexpress.com/winfx/2008/xaml/propertygrid"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/charts"
    xmlns:local="clr-namespace:NeuralPad.App.Controls"
    Title="NeuralPad" Width="1500" Height="900" WindowStartupLocation="CenterScreen">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="8" Margin="0,0,0,8" BorderBrush="#40444B" BorderThickness="1" CornerRadius="6">
            <StackPanel Orientation="Horizontal">
                <Button Content="▶ Run" Command="{Binding RunCommand}" Padding="14,7" Margin="0,0,6,0"/>
                <Button Content="⏭ Step" Command="{Binding StepCommand}" Padding="14,7" Margin="0,0,6,0"/>
                <Button Content="↻ Reset" Command="{Binding ResetCommand}" Padding="14,7" Margin="0,0,12,0"/>
                <Button Content="◀ Step Backward" Command="{Binding StepBackwardCommand}" Padding="14,7" Margin="0,0,6,0"/>
                <Button Content="◀◀ Run Backward" Command="{Binding RunBackwardCommand}" Padding="14,7" Margin="0,0,6,0"/>
                <Button Content="Optimizer Step" Command="{Binding OptimizerStepCommand}" Padding="14,7" Margin="0,0,20,0"/>
                <TextBlock Text="X1" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <dxe:SpinEdit Width="90" Value="{Binding X1, UpdateSourceTrigger=PropertyChanged}" Increment="0.05" Mask="n2"/>
                <TextBlock Text="X2" VerticalAlignment="Center" Margin="15,0,5,0"/>
                <dxe:SpinEdit Width="90" Value="{Binding X2, UpdateSourceTrigger=PropertyChanged}" Increment="0.05" Mask="n2"/>
                <TextBlock Text="Target" VerticalAlignment="Center" Margin="15,0,5,0"/>
                <dxe:SpinEdit Width="75" Value="{Binding Target, UpdateSourceTrigger=PropertyChanged}" Increment="1" MinValue="0" MaxValue="1" Mask="n0"/>
                <TextBlock Text="LR" VerticalAlignment="Center" Margin="15,0,5,0"/>
                <dxe:SpinEdit Width="75" Value="{Binding LearningRate, UpdateSourceTrigger=PropertyChanged}" Increment="0.01" MinValue="0" Mask="n3"/>
                <TextBlock Text="Output" VerticalAlignment="Center" Margin="20,0,5,0" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding OutputText}" VerticalAlignment="Center" FontSize="18"/>
                <TextBlock Text="Loss" VerticalAlignment="Center" Margin="15,0,5,0" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding LossText}" VerticalAlignment="Center" FontSize="18"/>
            </StackPanel>
        </Border>

        <dxdo:DockLayoutManager Grid.Row="1" DockingStyle="VS2010">
            <dxdo:LayoutGroup Orientation="Horizontal">
                <dxdo:LayoutGroup Orientation="Vertical" ItemWidth="300">
                <dxdo:LayoutPanel Caption="Forward Trace">
                    <ListBox ItemsSource="{Binding Trace}" SelectedItem="{Binding CurrentStep, Mode=OneWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Formula}" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </dxdo:LayoutPanel>
                <dxdo:LayoutPanel Caption="Backward Trace">
                    <ListBox ItemsSource="{Binding BackwardTrace}" SelectedItem="{Binding CurrentBackwardStep, Mode=OneWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Formula}" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </dxdo:LayoutPanel>
                </dxdo:LayoutGroup>

                <dxdo:LayoutGroup Orientation="Vertical">
                    <dxdo:DocumentGroup>
                        <dxdo:DocumentPanel Caption="Network" AllowClose="False">
                            <local:NetworkCanvas Network="{Binding Network}"
                                                 CurrentStep="{Binding CurrentStep}"
                                                 CurrentBackwardStep="{Binding CurrentBackwardStep}"
                                                 SelectedObject="{Binding SelectedObject, Mode=TwoWay}"/>
                        </dxdo:DocumentPanel>
                    </dxdo:DocumentGroup>

                    <dxdo:LayoutPanel Caption="Training / XOR" ItemHeight="310">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="135"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="145"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="4">
                                <Button Content="Train Sample" Command="{Binding TrainSampleCommand}" Padding="10,4" Margin="0,0,6,0"/>
                                <Button Content="Train Epoch" Command="{Binding TrainEpochCommand}" Padding="10,4" Margin="0,0,6,0"/>
                                <Button Content="Load in Debugger" Command="{Binding LoadTrainingSampleCommand}" Padding="10,4" Margin="0,0,6,0"/>
                                <Button Content="Clear History" Command="{Binding ResetTrainingCommand}" Padding="10,4"/>
                                <TextBlock Text="{Binding TrainingStatus}" VerticalAlignment="Center" Margin="14,0,0,0" FontWeight="SemiBold"/>
                            </StackPanel>
                            <dxg:GridControl Grid.Row="1" ItemsSource="{Binding TrainingSamples}" SelectedItem="{Binding SelectedTrainingSample}">
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn FieldName="X1" Header="X1" ReadOnly="True"/>
                                    <dxg:GridColumn FieldName="X2" Header="X2" ReadOnly="True"/>
                                    <dxg:GridColumn FieldName="Target" Header="Target" ReadOnly="True"/>
                                    <dxg:GridColumn FieldName="PredictionText" Header="Prediction" ReadOnly="True"/>
                                    <dxg:GridColumn FieldName="LossText" Header="Loss" ReadOnly="True"/>
                                </dxg:GridControl.Columns>
                                <dxg:GridControl.View>
                                    <dxg:TableView ShowGroupPanel="False" AutoWidth="True" NavigationStyle="Row"/>
                                </dxg:GridControl.View>
                            </dxg:GridControl>
                            <dxc:ChartControl Grid.Row="2" DataSource="{Binding TrainingHistory}">
                                <dxc:XYDiagram2D>
                                    <dxc:LineSeries2D DisplayName="Average BCE"
                                                      ArgumentDataMember="Epoch"
                                                      ValueDataMember="Loss"
                                                      MarkerVisible="True"/>
                                </dxc:XYDiagram2D>
                            </dxc:ChartControl>
                            <Grid Grid.Row="3" Margin="0,4,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <TextBlock Text="Breakpoints" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Button Content="+ Add" Command="{Binding AddBreakpointCommand}" Margin="10,0,4,0" Padding="8,2"/>
                                    <Button Content="Remove" Command="{Binding RemoveBreakpointCommand}" Padding="8,2"/>
                                    <TextBlock Text="{Binding BreakpointStatus}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <dxg:GridControl Grid.Row="1" ItemsSource="{Binding Breakpoints}" SelectedItem="{Binding SelectedBreakpoint}">
                                    <dxg:GridControl.Columns>
                                        <dxg:GridColumn FieldName="IsEnabled" Header="On" Width="45"/>
                                        <dxg:GridColumn FieldName="Kind" Header="Condition" Width="*"/>
                                        <dxg:GridColumn FieldName="Expression" Header="Expression" Width="*"/>
                                        <dxg:GridColumn FieldName="Threshold" Header="Value" Width="80"/>
                                        <dxg:GridColumn FieldName="Status" Header="Status" Width="90" ReadOnly="True"/>
                                    </dxg:GridControl.Columns>
                                    <dxg:GridControl.View><dxg:TableView ShowGroupPanel="False" AutoWidth="True" NavigationStyle="Cell"/></dxg:GridControl.View>
                                </dxg:GridControl>
                            </Grid>
                        </Grid>
                    </dxdo:LayoutPanel>

                    <dxdo:LayoutPanel Caption="Snapshots / Compare" ItemHeight="260">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="90"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="4">
                                <Button Content="Capture Snapshot" Command="{Binding CaptureSnapshotCommand}" Padding="10,4" Margin="0,0,6,0"/>
                                <Button Content="Remove" Command="{Binding RemoveSnapshotCommand}" Padding="10,4" Margin="0,0,12,0"/>
                                <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox Width="120" ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SnapshotFrom}" Margin="0,0,8,0"/>
                                <TextBlock Text="To" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox Width="120" ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SnapshotTo}" Margin="0,0,8,0"/>
                                <Button Content="Compare" Command="{Binding CompareSnapshotsCommand}" Padding="10,4"/>
                                <TextBlock Text="{Binding SnapshotStatus}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                            <dxg:GridControl Grid.Row="1" ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshot}">
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn FieldName="Name" Header="Snapshot" Width="*"/>
                                    <dxg:GridColumn FieldName="Epoch" Header="Epoch" Width="70"/>
                                    <dxg:GridColumn FieldName="CreatedAt" Header="Created" Width="150"/>
                                </dxg:GridControl.Columns>
                                <dxg:GridControl.View><dxg:TableView ShowGroupPanel="False" AutoWidth="True" NavigationStyle="Row"/></dxg:GridControl.View>
                            </dxg:GridControl>
                            <dxg:GridControl Grid.Row="2" ItemsSource="{Binding SnapshotComparison}">
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn FieldName="Parameter" Header="Parameter" Width="*"/>

                                    <dxg:GridColumn FieldName="FromValue" Header="From" Width="100">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings DisplayFormat="0.000000"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>

                                    <dxg:GridColumn FieldName="ToValue" Header="To" Width="100">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings DisplayFormat="0.000000"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>

                                    <dxg:GridColumn FieldName="Delta" Header="Δ" Width="100">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings DisplayFormat="+0.000000;-0.000000;0.000000"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>

                                    <dxg:GridColumn FieldName="AbsoluteDelta" Header="|Δ|" Width="100">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings DisplayFormat="0.000000"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                </dxg:GridControl.Columns>
                                <dxg:GridControl.View><dxg:TableView ShowGroupPanel="False" AutoWidth="True" NavigationStyle="Row"/></dxg:GridControl.View>
                            </dxg:GridControl>
                        </Grid>
                    </dxdo:LayoutPanel>

                    <dxdo:LayoutPanel Caption="Watch" ItemHeight="230">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="4">
                                <Button Content="+ Watch" Command="{Binding AddWatchCommand}" Padding="10,4" Margin="0,0,6,0"/>
                                <Button Content="Remove" Command="{Binding RemoveWatchCommand}" Padding="10,4"/>
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                                           Text="Examples: H1.Activation   O1.Z   H1.Bias   W(H1,O1)" Opacity="0.65"/>
                            </StackPanel>
                            <dxg:GridControl Grid.Row="1" ItemsSource="{Binding Watches}" SelectedItem="{Binding SelectedWatch}">
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn FieldName="Expression" Header="Expression" Width="2*"/>
                                    <dxg:GridColumn FieldName="Value" Header="Value" Width="*" ReadOnly="True"/>
                                    <dxg:GridColumn FieldName="Error" Header="Status" Width="2*" ReadOnly="True"/>
                                </dxg:GridControl.Columns>
                                <dxg:GridControl.View>
                                    <dxg:TableView ShowGroupPanel="False" AutoWidth="True" NavigationStyle="Cell"/>
                                </dxg:GridControl.View>
                            </dxg:GridControl>
                        </Grid>
                    </dxdo:LayoutPanel>
                </dxdo:LayoutGroup>

                <dxdo:LayoutPanel Caption="Inspector" ItemWidth="320">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding SelectionText}" Margin="8" TextWrapping="Wrap" FontWeight="SemiBold"/>
                            <dxprg:PropertyGridControl Grid.Row="1"
                                SelectedObject="{Binding SelectedObject}"
                                ShowSearchBox="True"/>
                        </Grid>
                        <Border Grid.Row="1" Margin="0,8,0,0" Padding="10" BorderBrush="#40444B" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Current math" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding Formula}" TextWrapping="Wrap" FontFamily="Consolas"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </dxdo:LayoutPanel>
            </dxdo:LayoutGroup>
        </dxdo:DockLayoutManager>

        <StatusBar Grid.Row="2" Margin="0,8,0,0">
            <TextBlock Text="{Binding StepStatus}"/>
        </StatusBar>
    </Grid>
</dx:ThemedWindow>